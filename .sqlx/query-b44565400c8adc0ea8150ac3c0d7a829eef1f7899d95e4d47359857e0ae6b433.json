  "query": "\n        SELECT scs.support_id AS source_id, scs.acquisition AS \"acquisition: DbSupportSkillAcquisition\"\n        FROM support_card_skills scs\n        JOIN support_cards sc ON sc.support_id = scs.support_id\n        WHERE scs.skill_id = $1\n        AND sc.rarity != 'r'\n        ",
