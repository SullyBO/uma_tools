  "db_name": "PostgreSQL",
  "query": "\n        SELECT s.id, s.name, s.category as \"category: DbSkillCategory\",\n            s.rarity as \"rarity: DbSkillRarity\",\n            s.sp_cost, us.acquisition as \"acquisition: DbSkillAcquisition\",\n            us.evolved_from\n        FROM uma_skills us\n        JOIN skills s ON s.id = us.skill_id\n        WHERE us.uma_id = $1\n        ORDER BY s.name\n        ",
